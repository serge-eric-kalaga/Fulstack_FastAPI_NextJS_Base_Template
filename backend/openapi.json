              "+22670000000"
            ],
            "title": "Telephone"
          },
          "username": {
            "description": "Nom d’utilisateur unique identifiant le compte.",
            "examples": [
              "utilisateur_demo"
            ],
            "include": "true",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "CurrentUserModel",
        "type": "object"
      },
