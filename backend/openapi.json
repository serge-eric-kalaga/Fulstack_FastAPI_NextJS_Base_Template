{
  "components": {
    "schemas": {
      "AuthConfiguration": {
        "description": "Options publiques que le frontend utilise pour adapter l’inscription.",
        "properties": {
          "email_verification_enabled": {
            "description": "Exiger une confirmation de l’adresse avant la connexion des nouveaux comptes.",
            "title": "Email Verification Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "email_verification_enabled"
        ],
        "title": "AuthConfiguration",
        "type": "object"
      },
      "Body_uploadProfilePhoto": {
        "properties": {
          "photo": {
            "contentMediaType": "application/octet-stream",
            "description": "Photo fixe JPEG, PNG ou WebP, 5 Mio maximum par défaut. Réencodée en WebP, 1024 × 1024 maximum, sans métadonnées.",
            "title": "Photo",
            "type": "string"
          }
        },
        "required": [
          "photo"
        ],
        "title": "Body_uploadProfilePhoto",
        "type": "object"
      },
      "ChangeEmail": {
        "additionalProperties": false,
        "description": "Associer une adresse de récupération après réauthentification.",
        "properties": {
          "current_password": {
            "description": "Mot de passe actuel, requis pour changer l’adresse.",
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "description": "Adresse e-mail unique de récupération.",
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "current_password"
        ],
        "title": "ChangeEmail",
        "type": "object"
      },
      "ChangePassword": {
        "additionalProperties": false,
        "description": "Vérifier le mot de passe actuel avant de révoquer toutes les sessions.",
        "properties": {
          "current_password": {
            "description": "Mot de passe actuel du compte.",
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string",
            "writeOnly": true
          },
          "new_password": {
            "description": "Nouveau mot de passe (8 à 128 caractères).",
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePassword",
        "type": "object"
      },
      "ConfirmEmail": {
        "additionalProperties": false,
        "description": "Secret reçu par e-mail, jamais retourné par l’API.",
        "properties": {
          "token": {
            "description": "Jeton de confirmation temporaire à usage unique.",
            "format": "password",
            "maxLength": 43,
            "minLength": 43,
            "title": "Token",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ],
        "title": "ConfirmEmail",
        "type": "object"
      },
      "CreateUserModel": {
        "description": "Informations nécessaires à la création d’un compte utilisateur.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "format": "email",
                "maxLength": 254,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Adresse privée de récupération, obligatoire si EMAIL_VERIFICATION_ENABLED est activée.",
            "title": "Email"
          },
          "language": {
            "default": "fr",
            "description": "Langue du lien de confirmation : fr ou en.",
            "pattern": "^(fr|en)$",
            "title": "Language",
            "type": "string"
          },
          "password": {
            "description": "Mot de passe à définir pour le compte. Il est haché par le backend avant son enregistrement. Ce champ doit être présent dans la requête.",
            "examples": [
              "ExempleMotDePasse!2026"
            ],
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "telephone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Numéro de téléphone facultatif.",
            "examples": [
              "+22670000000"
            ],
            "title": "Telephone"
          },
          "username": {
            "description": "Nom d’utilisateur unique à créer.",
            "examples": [
              "utilisateur_demo"
            ],
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "CreateUserModel",
        "type": "object"
      },
      "CurrentUserModel": {
        "description": "Profil privé du compte connecté et dernière authentification réussie.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "format": "email",
                "type": "string"
              },
              {
                "type": "null"
